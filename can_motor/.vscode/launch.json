{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 Debug (DAP)",
            "type": "cortex-debug",
            "serverpath": "openocd.exe",
            "gdb": "D:\\arm-gnu-toolchain-13.3.rel1-mingw-w64-i686-arm-none-eabi\\bin\\arm-none-eabi-gdb.exe",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/can_motor.elf",
            // preLaunchTask 走 build_direct.ps1（本机 cmake configure 会卡住）
            // 若想改成 cmake 路线：换成 "cmake-build-debug"（需先跑一次 cmake-configure-debug）
            "preLaunchTask": "gcc-direct-build",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IGH6",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            }
        },

        {
            "name": "STM32 Debug (STLink)",
            "type": "cortex-debug",
            "serverpath": "openocd.exe",
            "gdb": "D:\\arm-gnu-toolchain-13.3.rel1-mingw-w64-i686-arm-none-eabi\\bin\\arm-none-eabi-gdb.exe",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/can_motor.elf",
            "preLaunchTask": "gcc-direct-build",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IGH6",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
        },

    ]
}
